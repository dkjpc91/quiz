<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.MainActivity">

    <!-- Optional fullscreen banner -->
    <ImageView
        android:visibility="gone"
        android:id="@+id/homefullscreenbanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/logo" />

    <!-- Loading animation -->
    <com.airbnb.lottie.LottieAnimationView
        android:visibility="visible"
        android:id="@+id/homeviewloading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_rawRes="@raw/loading"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <!-- AppBar with CollapsingToolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="450dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleCollapseMode="scale"
            app:contentScrim="#E8F1F0"
            app:collapsedTitleTextColor="#F41505"
            app:collapsedTitleTextAppearance="@style/CollapsedTitleTextStyle"
            app:expandedTitleTextColor="#F41505"
            app:expandedTitleTextAppearance="?attr/actionBarTheme"
            app:collapsedTitleGravity="center">

            <!-- Book preview container -->
            <LinearLayout
                android:id="@+id/bookContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="99dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                app:layout_collapseMode="parallax">

                <!-- Book cover -->
                <ImageView
                    android:id="@+id/appbanneriv"
                    android:layout_width="180dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo"
                    android:background="@drawable/book_spine_gradient"
                    android:elevation="4dp"
                    android:clipToOutline="true" />

                <!-- Book title and description -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/bookNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book Title Goes Here"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/bookDescriptionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book description will appear here. It can span multiple lines depending on the content length."
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/home_title_bg"
                app:title="@string/app_name"
                app:titleTextAppearance="?attr/actionBarTheme"
                app:titleCentered="true"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

            <!-- Optional header image -->
            <ImageView
                android:id="@+id/appbarheading"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:src="@drawable/learnsource"
                android:background="@drawable/grid_bg" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- RecyclerView placed below AppBarLayout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/homeviewsubjects"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_subject_grid" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
